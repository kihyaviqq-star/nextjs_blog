// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model with Auth.js support
model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique // URL-friendly username for profiles
  email         String    @unique // Email for authentication/login
  password      String?   // Optional for OAuth users
  emailVerified DateTime?
  avatarUrl     String?
  bio           String?
  role          String    @default("USER") // USER, EDITOR, or ADMIN
  
  // Public profile email (can differ from login email)
  publicEmail   String?   // Email to display on profile
  showEmail     Boolean   @default(false) // Whether to show email on public profile
  
  // Social links
  telegram      String?
  vk            String?
  twitter       String?
  github        String?
  linkedin      String?
  website       String?
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  posts         Post[]
  comments      Comment[]
  reviews       Review[]
  accounts      Account[]
  sessions      Session[]
  bookmarks     Bookmark[]
  reactions     PostReaction[]
}

// Auth.js models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Blog Post model
model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  coverImage  String?
  tags        String   // JSON string array
  content     String   // JSON string
  sources     String?  // JSON string array of source URLs
  publishedAt DateTime @default(now())
  readTime    String
  views       Int      @default(0) // View counter for analytics
  
  // Author relation
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  comments    Comment[]
  bookmarks   Bookmark[]
  reactions   PostReaction[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([authorId])
  @@index([slug])
  @@index([views]) // Index for sorting by popularity
  @@index([publishedAt]) // Index for navigation
}

// Comment model
model Comment {
  id        String   @id @default(cuid())
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  softwareId String?
  software   Software? @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([softwareId])
  @@index([authorId])
  @@index([parentId])
}

// Site Settings (Singleton)
model SiteSettings {
  id              String   @id @default("default")
  siteName        String   @default("Blog")
  logoUrl         String?
  faviconUrl      String?
  metaDescription String?  @default("Информационный портал о последних новостях и разработках в области искусственного интеллекта")
  footerText      String?  @default("Сделано с ❤ для всех, кто интересуется ИИ")
  homeSubtitle    String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// RSS Sources for article generator
model RSSSource {
  id        String   @id @default(cuid())
  name      String
  url       String
  enabled   Boolean  @default(true)
  isDefault Boolean  @default(false) // Predefined sources that cannot be deleted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([url])
  @@index([enabled])
}

// Redirect model for handling slug changes
model Redirect {
  id        String   @id @default(cuid())
  fromSlug  String   @unique
  toSlug    String
  createdAt DateTime @default(now())

  @@index([fromSlug])
  @@index([toSlug])
}

// AI Tools Directory Models

model SoftwareCategory {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  icon      String?
  
  parentId  String?
  parent    SoftwareCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  SoftwareCategory[] @relation("CategoryHierarchy")

  tools     Software[]
  createdAt DateTime   @default(now())
}

model Software {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  shortDesc   String
  websiteUrl  String?
  logoUrl     String?
  pricing     String   @default("Free") // Legacy field, keeping for backwards compatibility
  
  // New Global Software Fields
  platforms       String?  // JSON string array e.g. ["Windows", "macOS", "Web"]
  licenseType     String?  // e.g. "Open Source", "Freeware", "Shareware", "Paid"
  screenshots     String?  // JSON string array of image URLs
  size            String?  // e.g. "15.4 MB"
  developer       String?  // e.g. "Adobe Systems"
  tags            String?  // JSON string array e.g. ["Video Editing", "Free"]
  
  // Crawler fields
  isAutoGenerated Boolean  @default(false)
  sourceUrl       String?  // Where we crawled it from
  lastCrawledAt   DateTime?
  
  // Separation of AI Tools and General Software
  isAi            Boolean  @default(false)
  aiSpecs         String?  // JSON with ai-stat.ru metrics (benchmarks, pricing, etc)
  
  // Custom server download link
  localDownloadUrl String?

  // Moderation & Community submission
  status          String   @default("APPROVED") // APPROVED, PENDING, REJECTED
  submittedBy     String?  // Username or email of submitter

  categoryId  String
  category    SoftwareCategory @relation(fields: [categoryId], references: [id])
  
  reviews     Review[]
  comments    Comment[]
  bookmarks   Bookmark[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([isAi])
  @@index([status])
  @@index([slug])
  @@index([name])
  @@index([createdAt])
}

model Review {
  id          String   @id @default(cuid())
  rating      Int
  content     String?
  
  softwareId  String
  software    Software @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([softwareId])
  @@index([authorId])
}

// System Automation Models
model AutomationSettings {
  id                    String   @id @default("default")
  
  // Software Scraper
  softwareAutoEnabled   Boolean  @default(false)
  softwareItemsPerRun   Int      @default(5)
  softwareLastRun       DateTime?
  
  // AI Scraper
  aiAutoEnabled         Boolean  @default(false)
  aiItemsPerRun         Int      @default(5)
  aiLastRun             DateTime?
  
  // Blog Generator
  blogAutoEnabled       Boolean  @default(false)
  blogPostsPerRun       Int      @default(1)
  blogLastRun           DateTime?
  blogTopics            String   @default("Искусственный интеллект, Нейросети, Программирование, IT-индустрия") // JSON or string
  blogLlmModel          String   @default("openai/gpt-4o-mini")
  blogLlmCost           Float    @default(0.00) // optional reference for cost per 1M tokens
  
  updatedAt             DateTime @updatedAt
}

model AutomationLog {
  id          String   @id @default(cuid())
  type        String   // "SOFTWARE", "AI", "BLOG"
  status      String   // "SUCCESS", "ERROR", "RUNNING"
  itemsAdded  Int      @default(0)
  message     String?
  createdAt   DateTime @default(now())
  
  @@index([type])
  @@index([createdAt])
}

// User Bookmarks for Posts and Software/AI Tools
model Bookmark {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  postId     String?
  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  softwareId String?
  software   Software? @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime  @default(now())

  @@unique([userId, postId])
  @@unique([userId, softwareId])
  @@index([userId])
  @@index([postId])
  @@index([softwareId])
}

// Post Reactions (e.g. FIRE, IDEA, ROCKET, HEART)
model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  type      String   // "FIRE", "IDEA", "ROCKET", "HEART"
  ipHash    String   // Hashed IP for anonymous users or userId
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([postId, ipHash, type])
  @@index([postId])
  @@index([userId])
}

